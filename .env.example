# UCAR 6.0 — copy to .env and fill in. NEVER commit .env. NEVER paste these into chat logs.

# The 20-char ref from your Supabase dashboard URL: https://supabase.com/dashboard/project/<THIS>
PROJECT_REF=

# From Dashboard -> Settings -> API (after you rotate the leaked service key)
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=

# Invent a long random string. This gates the crawler/extract/admin endpoints.
#   openssl rand -hex 32
ADMIN_KEY=

# From console.anthropic.com. Extraction uses Haiku by default (cheap, fast).
ANTHROPIC_API_KEY=
